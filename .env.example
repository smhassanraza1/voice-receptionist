# Copy to .env and fill in. Everything the services need, in one place.
# Keep comments on their own lines: Docker Compose reads `KEY=   # note` as the value "# note".

# --- LiveKit (Cloud project, or a local `livekit-server --dev`) ---------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker name the token server dispatches to; the voice agent registers under the same name.
AGENT_NAME=receptionist

# --- Model providers ----------------------------------------------------------------------
# gpt-realtime-2, pipeline LLM, eval simulator/judge, caller TTS
OPENAI_API_KEY=
# pipeline STT (nova-3)
DEEPGRAM_API_KEY=
# pipeline TTS (sonic-3)
CARTESIA_API_KEY=
# optional: only for RECEPTIONIST_TTS_PROVIDER=elevenlabs
ELEVEN_API_KEY=

# --- Architecture switch (per-call override comes from the browser / dispatch metadata) ---
# realtime | pipeline
RECEPTIONIST_MODE=realtime
# speech-to-speech model
OPENAI_REALTIME_MODEL=gpt-realtime-2
# server | livekit
RECEPTIONIST_REALTIME_TURN_DETECTION=server
# adaptive | vad
RECEPTIONIST_INTERRUPTION_MODE=adaptive
# pipeline STT model (Deepgram)
RECEPTIONIST_STT_MODEL=nova-3
# pipeline text LLM
RECEPTIONIST_LLM_MODEL=gpt-4.1-mini
# cartesia | elevenlabs
RECEPTIONIST_TTS_PROVIDER=cartesia
# hang up after this many seconds; 0 turns the cap off
RECEPTIONIST_MAX_CALL_SECONDS=600
# optional: write one JSON call record per call into this directory
# RECEPTIONIST_CALL_LOG_DIR=.cache/calls

# --- MCP server (booking + RAG) -------------------------------------------------------------
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# 32+ random bytes; `make secrets` prints one
MCP_JWT_SECRET=
# `make token` mints it (Docker: `make token AUDIENCE=http://mcp:8765/mcp`)
MCP_AUTH_TOKEN=
MCP_DB_PATH=data/clinic.db
# extra Host header values to accept behind a proxy (DNS-rebinding protection), as a JSON list
# MCP_ALLOWED_HOSTS=["receptionist.example.com"]
# none | fastembed (needs `uv sync --extra dense`) | openai (embeds with OPENAI_API_KEY)
RAG_DENSE=none

# --- Billing agent (A2A) --------------------------------------------------------------------
BILLING_AGENT_URL=http://127.0.0.1:8766
# 16+ chars, shared by the voice agent and the billing agent
BILLING_AGENT_TOKEN=
# auto: OpenAI when OPENAI_API_KEY is set; off: deterministic rules
BILLING_AGENT_LLM=auto
BILLING_AGENT_MODEL=gpt-4.1-mini

# --- Web server, operator console, human handoff ----------------------------------------
WEB_BASE_URL=http://127.0.0.1:8000
# voice agent -> web server (escalations)
INTERNAL_API_TOKEN=
# operator console login
OPERATOR_PASSCODE=
# where SIP calls are transferred: +15550100000, tel:+15550100000 or sip:frontdesk@example.com
HUMAN_TRANSFER_NUMBER=
# cold (SIP REFER) | warm (needs LIVEKIT_SIP_OUTBOUND_TRUNK)
HUMAN_TRANSFER_MODE=cold
LIVEKIT_SIP_OUTBOUND_TRUNK=
# Behind a reverse proxy on another host, set FORWARDED_ALLOW_IPS to the proxy's address, or
# the per-IP rate limits see the proxy instead of the caller. uvicorn reads it from the process
# environment: Docker Compose passes this file through, `make webserver` needs it exported.

# --- Tracing (optional; each backend is on when configured) ---------------------------------
# true to send one trace per call to LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-receptionist
# EU / APAC accounts only
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# leave the call audio out of traces
# LANGSMITH_RECORD_AUDIO=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU; https://us.cloud.langfuse.com for US
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# keeps test calls out of production views
# LANGFUSE_TRACING_ENVIRONMENT=development
# or any OTLP backend:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Clinic clock (evals pin it; leave unset in production) -----------------------------
# CLINIC_NOW=2026-11-02T09:00:00
CLINIC_TIMEZONE=America/New_York

# --- Evals (optional overrides) -----------------------------------------------------------
# EVAL_SIMULATOR_MODEL=gpt-4.1-mini
# EVAL_JUDGE_MODEL=gpt-5-mini
# caller voice for voice evals, cached on disk
# EVAL_TTS_MODEL=gpt-4o-mini-tts
# EVAL_AUDIO_CACHE=.cache/eval-audio
# voice evals start a local livekit-server; found on PATH unless set here
# LIVEKIT_SERVER_BIN=/usr/local/bin/livekit-server
